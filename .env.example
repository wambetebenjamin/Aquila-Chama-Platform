# ---------------------------------------------------------------------------
# Aquila Chama Platform — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# RECAPTCHA_SECRET_KEY is read server-side only and is never sent to the browser.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://aquilachama.co.ke

# --- NextAuth ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Legacy alias read by NextAuth v5 when AUTH_SECRET is absent.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (optional). The provider activates the moment both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Demo accounts for the protected /app dashboard -------------------------
# Seeded on first boot. Change these before any real deployment.
DEMO_ADMIN_EMAIL=admin@maendeleo.co.ke
DEMO_ADMIN_PASSWORD=aquila-admin-2026
DEMO_TREASURER_EMAIL=treasurer@maendeleo.co.ke
DEMO_TREASURER_PASSWORD=aquila-treasurer-2026
DEMO_MEMBER_EMAIL=member@maendeleo.co.ke
DEMO_MEMBER_PASSWORD=aquila-member-2026

# --- Google reCAPTCHA -------------------------------------------------------
# v3 (invisible) site key. Safe to expose; it is public by design.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# v2 site key, used only when a v3 score falls below the threshold.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=
# Escalate to the visible v2 challenge below this score (brief: 0.5).
RECAPTCHA_MIN_SCORE=0.5

# --- Vercel KV (chama data, contributions, loans, meetings) ------------------
# Absent in local dev: the app transparently falls back to an in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Blob (generated PDF reports) ------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Nodemailer (/api/contact) ----------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Aquila Chama Platform <no-reply@aquilachama.co.ke>
CONTACT_TO_EMAIL=hello@aquilachama.co.ke

# --- WhatsApp Cloud API (reminders, guarantor notices, minutes, reports) -----
# With no token set, every feature gracefully falls back to wa.me deep links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# --- Pexels (build-time image fetch: npm run fetch:images) -------------------
PEXELS_API_KEY=
